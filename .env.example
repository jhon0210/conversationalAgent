# --- Proveedor LLM (solo en el backend; nunca en el front ni en logs) ---
# LLM_PROVIDER: anthropic (por defecto) | openai (cualquier API compatible con OpenAI) | mock (solo pruebas)
LLM_PROVIDER=anthropic

# Opción A: Anthropic
ANTHROPIC_API_KEY=

# Opción B: API compatible con OpenAI (hay opciones gratuitas, ver README)
#   Gemini:        LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   GitHub Models: LLM_BASE_URL=https://models.github.ai/inference
#   Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama (local):LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY puede ir vacío)
LLM_BASE_URL=
LLM_API_KEY=

# Modelo (obligatorio con LLM_PROVIDER=openai; con anthropic usa claude-sonnet-4-5 si se omite)
LLM_MODEL=

# Límites de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=150000
LLM_TIMEOUT_MS=60000

# Reglas de negocio
# Fecha de ejecución para vigencias (YYYY-MM-DD). Vacío = fecha del sistema.
FECHA_EJECUCION=
DIAS_AVISO_VENCIMIENTO=30
# Zona horaria para "hoy" cuando no se fija FECHA_EJECUCION (un servidor en UTC adelantaría el día)
ZONA_HORARIA=America/Bogota

PORT=3000
